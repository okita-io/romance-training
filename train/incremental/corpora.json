{
  "max_segment_mb_default": 50,
  "multigrain_staging": "train/staging/multigrain",
  "training_mix_corpora": [
    "romance_books_korshuk",
    "horror_novel_chunks",
    "literotica_stories",
    "fiction_books",
    "gutenberg_fiction",
    "erotic_books_korshuk",
    "fantasy_books_korshuk"
  ],
  "corpora": {
    "romance_books_korshuk": {
      "label": "Romance books (BookRix full novels)",
      "input": "source-data/processed/romance_books_korshuk/chunks.jsonl",
      "expansion_ratio": 1.0
    },
    "horror_novel_chunks": {
      "label": "Horror (Gutenberg chunks)",
      "input": "source-data/processed/horror_novel_chunks/chunks.jsonl",
      "import_styled": "train/romance_corpus/horror_styled.jsonl",
      "expansion_ratio": 2.97
    },
    "literotica_stories": {
      "label": "Literotica stories (keep-tier)",
      "input": "source-data/processed/literotica_stories/chunks.jsonl",
      "expansion_ratio": 11.55
    },
    "fiction_books": {
      "label": "Fiction books (chapters)",
      "input": "source-data/processed/fiction_books/chunks.jsonl",
      "expansion_ratio": 6.36
    },
    "gutenberg_fiction": {
      "label": "Gutenberg fiction (~500w chunks)",
      "input": "source-data/processed/gutenberg_fiction/chunks.jsonl",
      "expansion_ratio": 1.0
    },
    "erotic_books_korshuk": {
      "label": "Erotic books (BookRix full novels)",
      "input": "source-data/processed/erotic_books_korshuk/chunks.jsonl",
      "expansion_ratio": 3.0
    },
    "fantasy_books_korshuk": {
      "label": "Fantasy books (BookRix full novels)",
      "input": "source-data/processed/fantasy_books_korshuk/chunks.jsonl",
      "expansion_ratio": 3.0
    }
  }
}
